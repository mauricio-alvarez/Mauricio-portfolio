---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ConceptGraph from './ConceptGraph.astro';
import { site, cvPath, type Lang } from '../data/site';
import { featured, more } from '../data/projects';
import { experience, education, skills } from '../data/cv';
import { ui, homePath } from '../i18n/ui';

import chat from '../assets/projects/local-models-chat.png';
import ocr from '../assets/projects/local-models-ocr.png';
import rl from '../assets/projects/rl-benchmark.png';
import invoices from '../assets/projects/invoice-login.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const cv = cvPath(lang);
const pad = (n: number) => String(n).padStart(2, '0');
const nav = [
  { href: '#projects', label: t.nav.projects },
  { href: '#about', label: t.nav.about },
  { href: '#cv', label: t.nav.cv },
  { href: '#contact', label: t.nav.contact },
];
---

<Base lang={lang}>
  <header class="site-header">
    <div class="wrap bar">
      <a class="brand" href={homePath(lang)} aria-label={site.name}>
        <span class="brand-mark" aria-hidden="true">MA</span>
        <span class="brand-name">{site.name}</span>
      </a>
      <nav class="nav" aria-label={lang === 'es' ? 'Secciones' : 'Sections'}>
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <div class="tools">
        <div class="lang" role="group" aria-label={t.langLabel}>
          <a href="/" hreflang="es" lang="es" data-lang-link aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
          <a href="/en/" hreflang="en" lang="en" data-lang-link aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        </div>
        <button class="icon-btn" type="button" data-theme-toggle aria-label={t.themeLabel} title={t.themeLabel}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <circle cx="12" cy="12" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
            <path d="M12 3.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor"></path>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="hero wrap">
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{t.eyebrow}</p>
      <h1>
        {t.heroTitle[0]}<em>{t.heroTitle[1]}</em>{t.heroTitle[2]}
      </h1>
      <p class="lead">{t.heroLead}</p>
      <div class="actions">
        <a class="btn primary" href="#projects">{t.ctaProjects}</a>
        {
          cv && (
            <a class="btn" href={cv} download>
              {t.ctaCv}
            </a>
          )
        }
        <a class="btn" href={site.github} target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
      </div>
      <ul class="focus" aria-label={lang === 'es' ? 'Áreas de trabajo' : 'Focus areas'}>
        {t.focus.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section id="projects" class="section wrap">
      <div class="section-head" data-reveal>
        <p class="kicker">01</p>
        <h2>{t.projectsTitle}</h2>
        <p class="section-lead">{t.projectsLead}</p>
      </div>

      <div class="featured">
        {
          featured.map((p, i) => (
            <article class="project" data-reveal>
              <figure class={`media media-${p.media}`}>
                <div class="media-stage">
                  {p.media === 'graph' && <ConceptGraph />}
                  {p.media === 'phones' && (
                    <div class="phones">
                      <Image src={chat} alt={lang === 'es' ? 'Pantalla de chat de Local Models con Gemma 3 respondiendo en el dispositivo' : 'Local Models chat screen with Gemma 3 answering on device'} widths={[240, 480]} sizes="(max-width: 720px) 38vw, 220px" />
                      <Image src={ocr} alt={lang === 'es' ? 'Pantalla de OCR de Local Models' : 'Local Models OCR screen'} widths={[240, 480]} sizes="(max-width: 720px) 38vw, 220px" />
                    </div>
                  )}
                  {p.media === 'figure' && (
                    <Image class="plot" src={rl} alt={lang === 'es' ? 'Gráfico de barras con la tasa de victoria de buscadores y escondidos en ocho fases de entrenamiento' : 'Bar chart of seeker and hider win rates across eight training phases'} widths={[560, 900, 1240]} sizes="(max-width: 900px) 88vw, 560px" />
                  )}
                  {p.media === 'browser' && (
                    <div class="browser">
                      <div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i><span>{p.demo?.replace('https://', '').split('/')[0]}</span></div>
                      <Image src={invoices} alt={lang === 'es' ? 'Pantalla de inicio de sesión de la plataforma de facturas' : 'Login screen of the invoice platform'} widths={[560, 900, 1440]} sizes="(max-width: 900px) 88vw, 560px" />
                    </div>
                  )}
                </div>
                {p.caption && <figcaption>{p.caption[lang]}</figcaption>}
              </figure>

              <div class="project-body">
                <p class="meta">
                  <span class="num">{pad(i + 1)}</span>
                  <span>{p.kind[lang]}</span>
                  <span>{p.year}</span>
                </p>
                <h3>{p.title[lang]}</h3>
                <p class="summary">{p.summary[lang]}</p>
                <ul class="points">
                  {p.points[lang].map((point) => <li>{point}</li>)}
                </ul>
                <ul class="chips">
                  {p.stack.map((s) => <li>{s}</li>)}
                </ul>
                <p class="links">
                  {p.demo && (
                    <a class="link strong" href={p.demo} target="_blank" rel="noopener">{t.demo} <span aria-hidden="true">↗</span></a>
                  )}
                  <a class="link" href={p.repo} target="_blank" rel="noopener">{t.code} <span aria-hidden="true">↗</span></a>
                </p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="more">
        <h3 class="more-title" data-reveal>{t.moreTitle}</h3>
        <ul class="cards">
          {
            more.map((p) => (
              <li class="card" data-reveal>
                <p class="meta">
                  <span>{p.year}</span>
                  {p.team && <span>{t.team}</span>}
                </p>
                <h4>{p.title[lang]}</h4>
                <p class="summary">{p.summary[lang]}</p>
                <ul class="chips">
                  {p.stack.map((s) => <li>{s}</li>)}
                </ul>
                <p class="links">
                  {p.demo && (
                    <a class="link strong" href={p.demo} target="_blank" rel="noopener">{t.demo} <span aria-hidden="true">↗</span></a>
                  )}
                  <a class="link" href={p.repo} target="_blank" rel="noopener">{t.code} <span aria-hidden="true">↗</span></a>
                </p>
              </li>
            ))
          }
        </ul>
        <p class="all-repos" data-reveal>
          <a class="link" href={`${site.github}?tab=repositories`} target="_blank" rel="noopener">{t.allRepos} <span aria-hidden="true">↗</span></a>
        </p>
      </div>
    </section>

    <section id="about" class="section wrap">
      <div class="section-head" data-reveal>
        <p class="kicker">02</p>
        <h2>{t.aboutTitle}</h2>
      </div>
      <div class="about" data-reveal>
        <div class="prose">
          {t.about.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="skills">
          <h3 class="label">{t.skillsTitle}</h3>
          <dl>
            {
              skills.map((group) => (
                <div>
                  <dt>{group.label[lang]}</dt>
                  <dd>{group.items.join(' · ')}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <section id="cv" class="section wrap">
      <div class="section-head" data-reveal>
        <p class="kicker">03</p>
        <h2>{t.cvTitle}</h2>
        {cv && <p class="section-lead">{t.cvLead}</p>}
      </div>
      <div class="cv" data-reveal>
        {
          experience.length > 0 && (
            <div class="cv-group">
              <h3 class="label">{t.experience}</h3>
              <ol class="timeline">
                {experience.map((e) => (
                  <li>
                    <p class="period">{e.period[lang]}</p>
                    <div>
                      <h4>{e.title[lang]}</h4>
                      <p class="place">{e.place[lang]}</p>
                      {e.detail && <p class="detail">{e.detail[lang]}</p>}
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          )
        }
        <div class="cv-group">
          <h3 class="label">{t.education}</h3>
          <ol class="timeline">
            {
              education.map((e) => (
                <li>
                  <p class="period">{e.period[lang]}</p>
                  <div>
                    <h4>{e.title[lang]}</h4>
                    <p class="place">{e.place[lang]}</p>
                    {e.detail && <p class="detail">{e.detail[lang]}</p>}
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
        {
          cv && (
            <p class="cv-download">
              <a class="btn primary" href={cv} download>
                {t.ctaCv} <span aria-hidden="true">↓</span>
              </a>
            </p>
          )
        }
      </div>
    </section>

    <section id="contact" class="section wrap">
      <div class="contact" data-reveal>
        <p class="kicker">04 · {t.nav.contact}</p>
        <h2>
          {t.contactTitle[0]}<em>{t.contactTitle[1]}</em>{t.contactTitle[2]}
        </h2>
        <p class="lead">{t.contactLead}</p>
        <div class="actions">
          {
            site.email && (
              <a class="btn accent" href={`mailto:${site.email}`}>
                {t.emailCta}
              </a>
            )
          }
          {
            site.linkedin && (
              <a class="btn" href={site.linkedin} target="_blank" rel="noopener me">
                LinkedIn <span aria-hidden="true">↗</span>
              </a>
            )
          }
          <a class="btn" href={site.github} target="_blank" rel="noopener me">GitHub <span aria-hidden="true">↗</span></a>
        </div>
        {site.email && <p class="contact-email"><a href={`mailto:${site.email}`}>{site.email}</a></p>}
      </div>
    </section>
  </main>

  <footer class="site-footer wrap">
    <p>© {new Date().getFullYear()} {site.name}. {t.footer}</p>
    <p>
      <a class="link" href="#main">{t.top} <span aria-hidden="true">↑</span></a>
    </p>
  </footer>
</Base>
